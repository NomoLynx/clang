clang_program           =  { SOI ~ external_declaration* ~ EOI }

external_declaration = { preprocessor_directives | function_definition | declaration }

preprocessor_directives =  { include_directives | pragma_directives | define_directives }

/// preprocessor directives
preprocessor_directives_string_char  = _{ ASCII_ALPHANUMERIC | "." | "(" | ")" | "*" }
preprocessor_directives_string_chars = _{ preprocessor_directives_string_char+ }

/// definion of include directive
include_directives = {  "#include" ~ ("<" ~ path ~ ">" | "\"" ~ path ~ "\"") }

/// definion of pragma directive
pragma_directives = @{ "#pragma" ~ (!"\n" ~ ANY)* }

/// definion of define directive
define_directives_name  =  { preprocessor_directives_string_chars }

/// Use "!" to erase the atomic effect
define_directives_value = !{ (!"\n" ~ constant_expression) }
define_directives       = ${ "#define" ~ WSP+ ~ (!" " ~ define_directives_name) ~ WSP+ ~ define_directives_value }

function_definition = { 
  ((!TYPEDEF ~ declaration_specifiers) | type_alias ~ pointer?)? ~ // function return type
  declarator ~ // function name
  declaration_list? ~ // function parameters
  compound_statement // function body
}

// postfix expression
postfix_expression_part = {
  left_square_bracket ~ clang_expression ~ right_square_bracket
  | left_bracket ~ clang_expression? ~ right_bracket
  | "." ~ identifier
  | PTR_OP ~ identifier
}

sizeof_expression = { SIZEOF ~ constant_expression | SIZEOF ~ "(" ~ type_name ~ ")" }
cast_expression = { "(" ~ type_name ~ ")" ~ constant_expression } 

constant_expression = {
  sizeof_expression |
  cast_expression |
  tenary_expression ~ postfix_expression_part*
}

assignment_expression = { (constant_expression ~ assignment_operator)* ~ constant_expression }

assignment_operator = {
    "="
  | MUL_ASSIGN
  | DIV_ASSIGN
  | MOD_ASSIGN
  | ADD_ASSIGN
  | SUB_ASSIGN
  | LEFT_ASSIGN
  | RIGHT_ASSIGN
  | AND_ASSIGN
  | XOR_ASSIGN
  | OR_ASSIGN
}

clang_expression = { assignment_expression ~ ("," ~ assignment_expression)* }

declaration = { 
  declaration_specifiers ~ init_declarator_list? ~ ";" | 
  declaration_specifiers? ~ (type_alias ~ pointer*) ~ identifier ~ ";" |   //used for typedef case "typedef MyType* var0;"
  declaration_specifiers? ~ (type_alias ~ pointer*) ~ init_declarator_list ~ ";"
}

declaration_specifiers = { (storage_class_specifier | type_specifier| pointer | CONST | VOLATILE)+ }

init_declarator_list = { init_declarator ~ ("," ~ init_declarator)* }

init_declarator = { declarator ~ ("=" ~ initializer)? }

storage_class_specifier = _{
    TYPEDEF
  | EXTERN
  | STATIC
  | AUTO
  | REGISTER
}

type_specifier = _{
    VOID
  | CHAR
  | SHORT
  | INT
  | LONG
  | FLOAT
  | DOUBLE
  | SIGNED
  | UNSIGNED
  | struct_or_union_specifier
  | enum_specifier
}

type_alias = { !clang_keywords ~ identifier }

specifier_qualifier_list = { (type_specifier | CONST | VOLATILE)+ | (type_alias ~ pointer*) }

/// struct definition
struct_or_union_specifier = { (STRUCT | UNION) ~ identifier? ~ ("{" ~ struct_declaration+ ~ "}")? }
struct_declaration = { specifier_qualifier_list ~ struct_declarator_list ~ ";" }
struct_declarator_list = { struct_declarator ~ ("," ~ struct_declarator)* }
struct_declarator = { declarator? ~ (":" ~ constant_expression)? }

/// enum definition
enum_specifier = { ENUM ~ identifier? ~ ("{" ~ enumerator_list ~ "}")? }
enumerator_list = { enumerator ~ ("," ~ enumerator)* }
enumerator = { identifier ~ ("=" ~ constant_expression)? }

declarator = { pointer? ~ direct_declarator }

direct_declarator      =  {    (identifier | "(" ~ declarator ~ ")") ~ direct_declarator_part* }
direct_declarator_part = {
    "[" ~ constant_expression? ~ "]"
  | "(" ~ parameter_type_list? ~ ")"
  | "(" ~ identifier_list? ~ ")"
}
pointer  =  {  "*"+ ~ (CONST | VOLATILE)? }

parameter_type_list = { parameter_list ~ ("," ~ ELLIPSIS)? }
parameter_list = { parameter_declaration ~ ("," ~ parameter_declaration)* }
parameter_declaration = { 
    declaration_specifiers ~ (declarator | abstract_declarator)? | 
    type_alias ~ pointer? ~ identifier 
}

identifier_list = { identifier ~ ("," ~ identifier)* }

type_name = { specifier_qualifier_list ~ abstract_declarator? }

abstract_declarator = { pointer? ~ direct_abstract_declarator? }

direct_abstract_declarator = {
    ("(" ~ abstract_declarator ~ ")" | direct_abstract_declarator_part) ~ direct_abstract_declarator_part*
}

direct_abstract_declarator_part = _{
    "[" ~ constant_expression? ~ "]"
  | "(" ~ parameter_type_list? ~ ")"
}

initializer = { assignment_expression | "{" ~ initializer_list ~ (",")? ~ "}" }

initializer_list = _{ initializer ~ ("," ~ initializer)* }

statement = {
  jump_statement
  | labeled_statement
  | compound_statement
  | expression_statement
  | selection_statement
  | iteration_statement
  | asm_statement
}

asm_statement = { "__asm" ~ "{" ~ asm_code ~ "}" ~ ";" }
asm_code = { (!"}" ~ ANY)* }

labeled_statement = {
    CASE ~ constant_expression ~ ":" ~ statement
  | DEFAULT ~ ":" ~ statement
  | identifier ~ ":" ~ statement
}

compound_statement = { "{" ~ (declaration_list | statement)* ~ "}" }

declaration_list = { declaration ~ ("," ~ declaration)* }

// expr declaration specifiers are replication of declaration_specifiers but removed pointer. 
expr_declaration_specifiers = { (storage_class_specifier | type_specifier | CONST | VOLATILE)+ }
expression_statement = { (expr_declaration_specifiers? ~ clang_expression)? ~ ";" }

selection_statement = {
  IF ~ "(" ~ clang_expression ~ ")" ~ statement ~ (ELSE ~ statement)?
  | SWITCH ~ "(" ~ clang_expression ~ ")" ~ statement
}

iteration_statement = {
    WHILE ~ "(" ~ clang_expression ~ ")" ~ statement
  | DO ~ statement ~ WHILE ~ "(" ~ clang_expression ~ ")" ~ ";"
  | FOR ~ "(" ~ expression_statement+ ~ clang_expression? ~ ")" ~ statement
}

jump_statement = {
    GOTO ~ identifier ~ ";"
  | CONTINUE ~ ";"
  | BREAK ~ ";"
  | RETURN ~ clang_expression? ~ ";"
}

clang_keywords = _ { TYPEDEF | EXTERN | STATIC | AUTO | REGISTER | VOID | CHAR | SHORT | INT | LONG | FLOAT | DOUBLE |
  SIGNED | UNSIGNED | CONST | VOLATILE | SIZEOF | ENUM | DEFAULT | CASE | IF | ELSE | SWITCH | WHILE | DO | FOR | 
  GOTO | CONTINUE | BREAK | RETURN | STRUCT | UNION }

/// keywords
TYPEDEF      = { "typedef" }
EXTERN       = { "extern" }
STATIC       = { "static" }
AUTO         = { "auto" }
REGISTER     = { "register" }
VOID         = { "void" }
CHAR         = { "char" }
SHORT        = { "short" }
INT          = { "int" }
LONG         = { "long" }
FLOAT        = { "float" }
DOUBLE       = { "double" }
SIGNED       = { "signed" }
UNSIGNED     = { "unsigned" }
CONST        = { "const" }
VOLATILE     = { "volatile" }
MUL_ASSIGN   = { "*=" }
DIV_ASSIGN   = { "/=" }
MOD_ASSIGN   = { "%=" }
ADD_ASSIGN   = { "+=" }
SUB_ASSIGN   = { "-=" }
LEFT_ASSIGN  = { "<<=" }
RIGHT_ASSIGN = { ">>=" }
AND_ASSIGN   = { "&=" }
NE_OP        = { "!=" }
XOR_ASSIGN   = { "^=" }
OR_ASSIGN    = { "|=" }
LE_OP        = { "<=" }
GE_OP        = { ">=" }
INC_OP       = { "++" }
DEC_OP       = { "--" }
PTR_OP       = { "->" }
SIZEOF       = { "sizeof" }
ENUM         = { "enum" }
ELLIPSIS     = { "..." }
DEFAULT      = { "default" }
CASE         = { "case" }
IF           = { "if" }
ELSE         = { "else" }
SWITCH       = { "switch" }
WHILE        = { "while" }
DO           = { "do" }
FOR          = { "for" }
GOTO         = { "goto" }
CONTINUE     = { "continue" }
BREAK        = { "break" }
RETURN       = { "return" }
STRUCT       = { "struct" }
UNION        = { "union" }

/// implicit rule
BLOCK_COMMENT  =  { "/*" ~ (!"*/" ~ ANY)* ~ "*/" }
SINGLE_COMMENT = @{ "//" ~ (!"\n" ~ ANY)* ~ "\n" }
COMMENT        = _{ BLOCK_COMMENT | SINGLE_COMMENT }
WHITESPACE     = _{ " " | "\t" | "\r" | "\n" }
WSP            = _{ " " }

// ⁂ Basic Type Grammar

// ⁂ string
string_no_escape = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
string_escape = @{ "\"" ~ ("\"\"" | "\\\\" | "\\\"" | "\\/" | "\\b" | "\\f" | "\\n" | "\\r" | "\\t" | !"\"" ~ ANY )* ~ "\"" }
string = @{ string_escape | string_no_escape }

// ⁂ single quote string
sq_string_no_escape = @{ "'" ~ (!"'" ~ ANY)* ~ "'" }
sq_string_escape = @{ "'" ~ (!"'" ~ ANY | "''" | "\\\\" | "\\'" | "\\/" | "\\b" | "\\f" | "\\n" | "\\r" | "\\t")* ~ "'" }
sq_string = @{ sq_string_no_escape | sq_string_escape }

// ⁂ integer
integer = { hex_number | oct_number | bin_number | signed_integer }

// signed integer
sign = { ("+" | "-")? }
signed_integer = @{ sign? ~ ASCII_DIGIT+ ~ !(^"e" | "." ~ ASCII_DIGIT | ".e") }  // this !(^"e" | ".") is necessary to avoid int prematurally matched, while the value is actaully a float

// hex integer
hex_number = @{ "0x" ~ ASCII_HEX_DIGIT ~ ("_"? ~ ASCII_HEX_DIGIT)* }

// oct number 
oct_number = @{ "0o" ~ ('0'..'7') ~ ( "_"? ~ ('0'..'7') )* }

// bin integer
bin_number = @{ "0b" ~ ("0" | "1") ~ ( "_"? ~ ("0" | "1") )* }

// ⁂ float
float = ${ 
    sign? ~ "Inf"
    | "NaN"
    | decimal ~ (exponent)? ~ !"x"    //this !"x" is necessary to avoid pre-mature match 0x. with this !"x", float rule will fail and turn to match the hex number
}
decimal = @{ sign? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT*)? 
          | sign? ~ "." ~ ASCII_DIGIT* }
exponent = @{ ("e" | "E") ~ signed_integer }

number = { integer | float }

// ⁂ charcter
single_character = ${ "'" ~ ("\\U" ~ unicode_code_8 | "\\u" ~ unicode_code_4 | "\\x" ~ hex_code | "\\" ~ escape_char | ANY) ~ "'" }
escape_char = { "n" | "r" | "t" | "a" | "b" | "f" | "v" }
unicode_code_8 = { ASCII_HEX_DIGIT{8} }
unicode_code_4 = { ASCII_HEX_DIGIT{4} }
hex_code = { ASCII_HEX_DIGIT+ }

// ⁂ An identifier must start with an ascii_alpha character or an underscore
id = { identifier | sq_string }
identifier = @{ space_identifier | ascii_alpha ~ ("_" | "`" | ASCII_ALPHANUMERIC )* }
ascii_alpha = { ASCII_ALPHA | "_" | "`" }
space_identifier = ${ "`" ~ space_identifier_content ~  "`" }
space_identifier_content = { (!"`" ~ ANY)+ }

// ⁂ operators & separators
addition = { "+" }
subtraction = { "-" }
multiplication = { "*" }
division = { "/" }
rem = { "%" }

pow = { "**" }
logic_and = { "&&" }
logic_or  = { "||" }
logic_equal = { "==" }
logic_not_equal = { "!=" }
logic_not = { "!" }

operator_greater = { ">" }
operator_equal_or_greater = { ">=" }
operator_less = { "<" }
operator_equal_or_less = { "<=" }

bit_left_move = { "<<" }
bit_right_move = { ">>" }
bit_and = { "&" }
bit_or = { "|" }
bit_not = { "~" }
bit_exclusive_or = { "^" }

left_bracket = { "(" }
right_bracket = { ")" }
left_square_bracket = { "[" }
right_square_bracket = { "]" }

comma = { "," }
scope_open = { "{" }
scope_close = { "}" }

plusplus = { "++" }
minusminus = { "--" }
dot = { "." }

// ⁂ Define the rule for the expression
expression = { atom ~ (binary_op ~ atom)* }
binary_op = _{
    PTR_OP | dot |
    pow | 
    addition | subtraction | multiplication | division | rem |
    bool_op |
    bit_left_move | bit_right_move | bit_and | bit_or | bit_exclusive_or |
    compare_operators
}
unary_op = { plusplus | minusminus | subtraction | logic_not | bit_not | bit_and | pointer }
post_op = { plusplus | minusminus } 
atom = _{
    unary_op? ~ (
  cast_expression |
      bool_value | integer | float | identifier | single_character |
      string |
      "(" ~ tenary_expression ~ ")" |
      "(" ~ expression ~ ")"
    ) ~ postfix_expression_part* ~ post_op?
}

// ⁂ define the Boolean expression
bool_value = { ^"true" | ^"false" }
bool_op = _{ logic_and | logic_or }
compare_operators = _{ operator_equal_or_greater | operator_greater | operator_equal_or_less | operator_less | logic_equal | logic_not_equal }

tenary_expression = { expression ~ ("?" ~ expression ~ ":" ~ expression)? }

// ⁂ dotted name, e.g. ObjectA.PropertyB.PropertyC
dotted_name = @{ id ~ ("." ~ (id | decimal) )* }

// ⁂ separated name, e.g. ABC::DEF::abc
rust_name   = ${ id ~ ("::" ~ (id | decimal) )* }

// ⁂ hex byte
HEXBYTE = @{ ASCII_HEX_DIGIT{2} }
hexbytes = { HEXBYTE+ }

// ⁂ item count
item_count = { "[" ~ integer ~ "]" }

// ⁂ file and dir name
file_dir_name_char               =  _{ ASCII_ALPHANUMERIC | "_" }
file_or_directory_name_component =  { file_dir_name_char+ }
file_name                        = @{ file_or_directory_name_component ~ ("." ~ file_or_directory_name_component)* }
current_dir                      = _{ "." }
upper_dir                        = _{ ".." }
directory_name                   = @{ upper_dir | current_dir | file_or_directory_name_component ~ ("." ~ file_or_directory_name_component)* }
win_dir_splitter                 =  _{ "\\" }
unix_dir_splitter                =  _{ "/" }
win_directory                    =  ${ directory_name ~ (win_dir_splitter ~ directory_name)* ~ win_dir_splitter }
unix_directory                   =  ${ directory_name ~ (unix_dir_splitter ~ directory_name)* ~ unix_dir_splitter }
directory = { unix_directory | win_directory } 
path = ${ directory? ~ file_name }